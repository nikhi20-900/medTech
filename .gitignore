# Environments and secrets
.env
.env.*
.env*
**/.env
**/.env.*
**/.env*
*.pem

# IDEs and OS files
.DS_Store
.idea/
.vscode/
*.tsbuildinfo

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
